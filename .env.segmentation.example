# Environment Configuration for Segmentation Pipeline
# Copy this file to .env and fill in your actual values

# =============================================================================
# API KEYS (Required)
# =============================================================================

# Google Lens API Key from SerpAPI (required for product identification)
GOOGLE_LENS_API=your_serpapi_key_here

# Gemini API Key (for legacy pipeline fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# eBay API Credentials (for legacy pipeline)
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here

# API Key for securing endpoints
API_KEY=your_secure_api_key_here

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# Base URL for the main backend service
BASE_URL=http://localhost:3000

# YOLO Segmentation Service URL
SEGMENTATION_SERVICE_URL=http://localhost:8001

# Node Environment
NODE_ENV=development

# =============================================================================
# SEGMENTATION PIPELINE SETTINGS
# =============================================================================

# Enable/disable the new segmentation pipeline (true/false)
ENABLE_SEGMENTATION_PIPELINE=true

# Enable/disable Google Lens processing within segmentation
ENABLE_GOOGLE_LENS=true

# Maximum number of segments to process per category (1-5)
MAX_SEGMENTS_PER_CATEGORY=3

# Minimum confidence threshold for YOLO detections (0.1-1.0)
MIN_DETECTION_CONFIDENCE=0.5

# Enable transparent crop backgrounds for better Google Lens results
ENABLE_TRANSPARENT_CROPS=true

# Padding percentage around detected clothing items (0.05-0.2)
CROP_PADDING_PERCENT=0.1

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Maximum file size for image uploads (in bytes)
MAX_FILE_SIZE=10485760

# Request timeout for YOLO service calls (in milliseconds)
YOLO_TIMEOUT=30000

# Request timeout for Google Lens calls (in milliseconds)
GOOGLE_LENS_TIMEOUT=15000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable verbose YOLO logging
YOLO_VERBOSE=false

# Enable detailed segmentation logging
SEGMENTATION_DEBUG=false

# =============================================================================
# OPTIONAL: DATABASE CONFIGURATION
# =============================================================================

# If using database for caching/storage
# DATABASE_URL=postgresql://user:password@localhost:5432/steez
# REDIS_URL=redis://localhost:6379

# =============================================================================
# OPTIONAL: CLOUD DEPLOYMENT
# =============================================================================

# For cloud deployments, adjust these URLs accordingly:
# BASE_URL=https://your-app.herokuapp.com
# SEGMENTATION_SERVICE_URL=https://yolo-service.herokuapp.com

# For AWS/GCP/Azure deployments:
# BASE_URL=https://api.yourdomain.com
# SEGMENTATION_SERVICE_URL=https://yolo.yourdomain.com
